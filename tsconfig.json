{
  "compilerOptions": {
    "target": "ES2022",

    "module": "Node18",
    "moduleResolution": "Node16",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "declaration": true,
    "declarationMap": true,

    "rootDir": "src",
    "outDir": "dist",
    "noEmitOnError": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    "esModuleInterop": true
  },
  "include": ["src"]
}
