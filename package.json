{
  "name": "lrustlike",
  "version": "3.0.1",
  "description": "Rust like utilities and error handling",
  "keywords": [
    "rust",
    "types",
    "utils"
  ],
  "license": "MIT",
  "author": "Letder40 (https://github.com/Letder40)",
  "type": "module",

  "exports": {
    "./result": {
      "types": "./dist/result.d.ts",
      "import": "./dist/result.js"
    },
    "./option": {
      "types": "./dist/option.d.ts",
      "import": "./dist/option.js"
    },
    "./extensions/lazy": {
      "types": "./dist/extensions/lazy.d.ts",
      "import": "./dist/extensions/lazy.js"
    },
    "./extensions/eager": {
      "types": "./dist/extensions/eager.d.ts",
      "import": "./dist/extensions/eager.js"
    },
    "./extensions/iterable/lazy": {
      "types": "./dist/extensions/iterable/lazy.d.ts",
      "import": "./dist/extensions/iterable/lazy.js"
    },
    "./extensions/iterable/eager": {
      "types": "./dist/extensions/iterable/eager.d.ts",
      "import": "./dist/extensions/iterable/eager.js"
    }
  },

  "files": [
    "dist"
  ],

  "repository": {
    "type": "git",
    "url": "git+https://github.com/Letder40/lrustlike.git"
  },

  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  }
}
